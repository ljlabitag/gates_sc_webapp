# Keep the review deployment out of search results. The site carries official
# DOST branding on content that is not signed off yet, so it should not be
# indexable or citable as official.
# Remove this file when the site goes public.
#
# CSP notes: style-src needs 'unsafe-inline' because React's style={{...}}
# props set element.style directly, which CSP treats as an inline-style sink
# the same as style="" — there's no nonce-based styling setup here to avoid
# it. Fonts are self-hosted (brief §10 performance pass), so no
# fonts.googleapis.com/fonts.gstatic.com allowance is needed. connect-src's
# R2 host is where the browser PUTs proposal files directly via presigned URL
# (the upload flow) — update it if the storage endpoint ever changes (e.g.
# MinIO in Phase 2).
/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://gates-sc-webapp.c5f38af076958ae8289a040392373bec.r2.cloudflarestorage.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests

# Hashed asset filenames change on every build, so they are safe to cache hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
