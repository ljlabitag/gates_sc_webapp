# Keep the review deployment out of search results. The site carries official
# DOST branding on content that is not signed off yet, so it should not be
# indexable or citable as official.
# Remove this file when the site goes public.
/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Hashed asset filenames change on every build, so they are safe to cache hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
