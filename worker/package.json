{
  "name": "worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env=\"\"",
    "deploy:staging": "wrangler deploy --env staging",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply gates-sc-webapp --local",
    "db:migrate:remote": "wrangler d1 migrations apply gates-sc-webapp --remote",
    "db:migrate:staging": "wrangler d1 migrations apply gates-sc-webapp-staging --remote --env staging"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "drizzle-orm": "^0.38.3",
    "@aws-sdk/client-s3": "^3.716.0",
    "@aws-sdk/s3-request-presigner": "^3.716.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "drizzle-kit": "^0.30.1",
    "typescript": "~5.7.2",
    "wrangler": "^4.20.0"
  }
}
